<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <!-- Only for when Spring Boot has not set CONSOLE_LOG_PATTERN from logging.pattern.console.
             It is a property, as in Boot's own log4j2.xml, rather than an inline
             ${sys:CONSOLE_LOG_PATTERN:-...} default: that lookup ended at the first '}' inside
             the default, so every event was printed twice (the second copy without its date)
             followed by a stray '}'. -->
        <Property name="CONSOLE_LOG_PATTERN">%d{HH:mm:ss.SSS} %-5level [%thread] %notEmpty{[%X{traceId},%X{spanId}] }%logger{36} - %msg%n</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${sys:CONSOLE_LOG_PATTERN}"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
