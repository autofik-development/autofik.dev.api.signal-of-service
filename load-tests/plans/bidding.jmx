<?xml version="1.0" encoding="UTF-8"?><jmeterTestPlan version="1.2" properties="5.0" jmeter="5.5"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="SOS bidding war" enabled="true"><boolProp name="TestPlan.functional_mode">false</boolProp></TestPlan><hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="drivers" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(drivers,10)}</stringProp><stringProp name="ThreadGroup.ramp_time">5</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(duration,210)}</stringProp><stringProp name="ThreadGroup.delay">0</stringProp></ThreadGroup><hashTree><CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="users" enabled="true"><stringProp name="filename">/data/users.csv</stringProp><stringProp name="variableNames">userId,vehicleId,lat,lon,serviceGroupId</stringProp><boolProp name="recycle">true</boolProp><boolProp name="stopThread">false</boolProp><stringProp name="shareMode">shareMode.all</stringProp><boolProp name="quotedData">false</boolProp><stringProp name="delimiter">,</stringProp></CSVDataSet><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/v1/sos" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;userId&quot;:&quot;${userId}&quot;,&quot;serviceGroupId&quot;:&quot;${serviceGroupId}&quot;,&quot;description&quot;:&quot;loadtest&quot;,&quot;latitude&quot;:${lat},&quot;longitude&quot;:${lon},&quot;vehicleId&quot;:&quot;${vehicleId}&quot;,&quot;broadcastRadiusKm&quot;:15}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,18080)}</stringProp><stringProp name="HTTPSampler.path">/api/v1/sos</stringProp><stringProp name="HTTPSampler.method">POST</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="hdr" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">user-context</stringProp><stringProp name="Header.value">{&quot;user&quot;:{&quot;uuid&quot;:&quot;${userId}&quot;,&quot;role&quot;:&quot;USER&quot;,&quot;otpVerify&quot;:true,&quot;profileVerify&quot;:true,&quot;tokenStatus&quot;:&quot;active&quot;,&quot;isLogout&quot;:false}}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">service-code</stringProp><stringProp name="Header.value">loadtest</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="status 201" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">201</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">40</intProp><boolProp name="Assertion.assume_success">true</boolProp></ResponseAssertion><hashTree/><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="extract sosId" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">sosId</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.sosId</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">NONE</stringProp></JSONPostProcessor><hashTree/><JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="publish open ticket" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">if (prev.getResponseCode() == &quot;201&quot;) {
  def open = props.get(&quot;openSos&quot;); if (open == null) { synchronized (props) { open = props.get(&quot;openSos&quot;); if (open == null) { open = new java.util.concurrent.CopyOnWriteArrayList(); props.put(&quot;openSos&quot;, open) } } }
  open.add(vars.get(&quot;sosId&quot;))
}</stringProp></JSR223PostProcessor><hashTree/></hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="if" enabled="true"><stringProp name="IfController.condition">${__jexl3(&quot;${sosId}&quot; != &quot;NONE&quot;)}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="loop" enabled="true"><boolProp name="LoopController.continue_forever">true</boolProp><stringProp name="LoopController.loops">${__P(polls,4)}</stringProp></LoopController><hashTree><TestAction guiclass="TestActionGui" testclass="TestAction" testname="wait" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">${__P(poll_ms,5000)}</stringProp></TestAction><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/v1/bids/sos/{id}?sortBy=CHEAPEST" enabled="true"><stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,18080)}</stringProp><stringProp name="HTTPSampler.path">/api/v1/bids/sos/${sosId}?sortBy=CHEAPEST</stringProp><stringProp name="HTTPSampler.method">GET</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="hdr" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">user-context</stringProp><stringProp name="Header.value">{&quot;user&quot;:{&quot;uuid&quot;:&quot;${userId}&quot;,&quot;role&quot;:&quot;USER&quot;,&quot;otpVerify&quot;:true,&quot;profileVerify&quot;:true,&quot;tokenStatus&quot;:&quot;active&quot;,&quot;isLogout&quot;:false}}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">service-code</stringProp><stringProp name="Header.value">loadtest</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="status 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">40</intProp><boolProp name="Assertion.assume_success">true</boolProp></ResponseAssertion><hashTree/><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="extract cheapestBid" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">cheapestBid</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$[?(@.status == 'PENDING')].bidId</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">NONE</stringProp></JSONPostProcessor><hashTree/><JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="CHEAPEST is ascending" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">if (prev.getResponseCode() != &quot;200&quot;) return
def bids = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
def prices = bids.collect { new BigDecimal(it.price.toString()) }
for (int i = 1; i &lt; prices.size(); i++) if (prices[i] &lt; prices[i - 1]) { AssertionResult.setFailure(true); AssertionResult.setFailureMessage(&quot;CHEAPEST not sorted at &quot; + i + &quot;: &quot; + prices[i - 1] + &quot; &gt; &quot; + prices[i]); return }</stringProp></JSR223Assertion><hashTree/></hashTree></hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="if" enabled="true"><stringProp name="IfController.condition">${__jexl3(&quot;${cheapestBid}&quot; != &quot;NONE&quot;)}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="PATCH /api/v1/bids/{id}/status ACCEPTED" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;userId&quot;:&quot;${userId}&quot;,&quot;status&quot;:&quot;ACCEPTED&quot;}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,18080)}</stringProp><stringProp name="HTTPSampler.path">/api/v1/bids/${cheapestBid}/status</stringProp><stringProp name="HTTPSampler.method">PATCH</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="hdr" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">user-context</stringProp><stringProp name="Header.value">{&quot;user&quot;:{&quot;uuid&quot;:&quot;${userId}&quot;,&quot;role&quot;:&quot;USER&quot;,&quot;otpVerify&quot;:true,&quot;profileVerify&quot;:true,&quot;tokenStatus&quot;:&quot;active&quot;,&quot;isLogout&quot;:false}}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">service-code</stringProp><stringProp name="Header.value">loadtest</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="status 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">40</intProp><boolProp name="Assertion.assume_success">true</boolProp></ResponseAssertion><hashTree/><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="close ticket to new bidders" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def open = props.get(&quot;openSos&quot;); if (open != null) open.remove(vars.get(&quot;sosId&quot;))</stringProp></JSR223PreProcessor><hashTree/></hashTree></hashTree><TestAction guiclass="TestActionGui" testclass="TestAction" testname="wait" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">1000</stringProp></TestAction><hashTree/></hashTree></hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="mechanics" enabled="true"><stringProp name="ThreadGroup.on_sample_error">startnextloop</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">-1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(mechanics,200)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(ramp,30)}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(duration,210)}</stringProp><stringProp name="ThreadGroup.delay">0</stringProp></ThreadGroup><hashTree><CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="mechanics" enabled="true"><stringProp name="filename">/data/mechanics-available.csv</stringProp><stringProp name="variableNames">mechanicId,mlat,mlng</stringProp><boolProp name="recycle">true</boolProp><boolProp name="stopThread">false</boolProp><stringProp name="shareMode">shareMode.all</stringProp><boolProp name="quotedData">false</boolProp><stringProp name="delimiter">,</stringProp></CSVDataSet><hashTree/><UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="think" enabled="true"><stringProp name="ConstantTimer.delay">${__P(think_ms,200)}</stringProp><stringProp name="RandomTimer.range">${__P(think_range_ms,800)}</stringProp></UniformRandomTimer><hashTree/><TestAction guiclass="TestActionGui" testclass="TestAction" testname="pick" enabled="true"><intProp name="ActionProcessor.action">1</intProp><intProp name="ActionProcessor.target">0</intProp><stringProp name="ActionProcessor.duration">0</stringProp></TestAction><hashTree><JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="pick" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">def open = props.get(&quot;openSos&quot;)
if (open == null || open.isEmpty()) { vars.put(&quot;bidSos&quot;, &quot;NONE&quot;); return }
try { vars.put(&quot;bidSos&quot;, open.get(java.util.concurrent.ThreadLocalRandom.current().nextInt(open.size()))) } catch (IndexOutOfBoundsException e) { vars.put(&quot;bidSos&quot;, &quot;NONE&quot;) }
vars.put(&quot;price&quot;, String.format(&quot;%.2f&quot;, 10 + java.util.concurrent.ThreadLocalRandom.current().nextDouble(90)))</stringProp></JSR223PreProcessor><hashTree/></hashTree><IfController guiclass="IfControllerPanel" testclass="IfController" testname="if" enabled="true"><stringProp name="IfController.condition">${__jexl3(&quot;${bidSos}&quot; != &quot;NONE&quot;)}</stringProp><boolProp name="IfController.evaluateAll">false</boolProp><boolProp name="IfController.useExpression">true</boolProp></IfController><hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/v1/bids" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;mechanicId&quot;:&quot;${mechanicId}&quot;,&quot;sosId&quot;:&quot;${bidSos}&quot;,&quot;price&quot;:${price}}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,18080)}</stringProp><stringProp name="HTTPSampler.path">/api/v1/bids</stringProp><stringProp name="HTTPSampler.method">POST</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="hdr" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">mechanic-context</stringProp><stringProp name="Header.value">{&quot;mechanic&quot;:{&quot;uuid&quot;:&quot;${mechanicId}&quot;,&quot;otpVerify&quot;:true,&quot;profileVerify&quot;:true,&quot;tokenStatus&quot;:&quot;active&quot;,&quot;isLogout&quot;:false}}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">service-code</stringProp><stringProp name="Header.value">loadtest</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="status 201|409" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="0">201</stringProp><stringProp name="1">409</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">40</intProp><boolProp name="Assertion.assume_success">true</boolProp></ResponseAssertion><hashTree/></hashTree></hashTree></hashTree></hashTree></hashTree></jmeterTestPlan>