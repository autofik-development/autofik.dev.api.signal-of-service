<?xml version="1.0" encoding="UTF-8"?><jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3"><hashTree><TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="SOS stress" enabled="true"><boolProp name="TestPlan.functional_mode">false</boolProp></TestPlan><hashTree><ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="stress" enabled="true"><stringProp name="ThreadGroup.on_sample_error">continue</stringProp><elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp><stringProp name="ThreadGroup.num_threads">${__P(threads,5)}</stringProp><stringProp name="ThreadGroup.ramp_time">${__P(ramp,10)}</stringProp><boolProp name="ThreadGroup.scheduler">true</boolProp><stringProp name="ThreadGroup.duration">${__P(duration,180)}</stringProp></ThreadGroup><hashTree><CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="users" enabled="true"><stringProp name="filename">/data/users.csv</stringProp><stringProp name="variableNames">userId,vehicleId,lat,lon,serviceGroupId</stringProp><boolProp name="recycle">true</boolProp><boolProp name="stopThread">false</boolProp><stringProp name="shareMode">shareMode.all</stringProp><boolProp name="quotedData">false</boolProp></CSVDataSet><hashTree/><CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="mechanics" enabled="true"><stringProp name="filename">/data/mechanics.csv</stringProp><stringProp name="variableNames">mechanicId,mlat,mlng</stringProp><boolProp name="recycle">true</boolProp><boolProp name="stopThread">false</boolProp><stringProp name="shareMode">shareMode.all</stringProp><boolProp name="quotedData">false</boolProp></CSVDataSet><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/v1/sos" enabled="true"><boolProp name="HTTPSampler.postBodyRaw">true</boolProp><elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">false</boolProp><stringProp name="Argument.value">{&quot;userId&quot;:&quot;${userId}&quot;,&quot;serviceGroupId&quot;:&quot;${serviceGroupId}&quot;,&quot;description&quot;:&quot;loadtest&quot;,&quot;latitude&quot;:${lat},&quot;longitude&quot;:${lon},&quot;vehicleId&quot;:&quot;${vehicleId}&quot;,&quot;broadcastRadiusKm&quot;:10}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp><stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,18080)}</stringProp><stringProp name="HTTPSampler.path">/api/v1/sos</stringProp><stringProp name="HTTPSampler.method">POST</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="hdr" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Content-Type</stringProp><stringProp name="Header.value">application/json</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">user-context</stringProp><stringProp name="Header.value">{&quot;user&quot;:{&quot;uuid&quot;:&quot;${userId}&quot;,&quot;role&quot;:&quot;USER&quot;,&quot;otpVerify&quot;:true,&quot;profileVerify&quot;:true,&quot;tokenStatus&quot;:&quot;active&quot;,&quot;isLogout&quot;:false}}</stringProp></elementProp><elementProp name="" elementType="Header"><stringProp name="Header.name">service-code</stringProp><stringProp name="Header.value">loadtest</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="status 201" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">201</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="extract sosId" enabled="true"><stringProp name="JSONPostProcessor.referenceNames">sosId</stringProp><stringProp name="JSONPostProcessor.jsonPathExprs">$.sosId</stringProp><stringProp name="JSONPostProcessor.match_numbers">1</stringProp><stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp></JSONPostProcessor><hashTree/></hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="STOMP connect+subscribe" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">
import java.net.URI
import java.net.http.*
import java.util.concurrent.*
def nul = "" + (char) 0
def ctx = { String key, String id -&gt; '{"' + key + '":{"uuid":"' + id + '",' + (key == 'user' ? '"role":"USER",' : '') + '"otpVerify":true,"profileVerify":true,"tokenStatus":"active","isLogout":false}}' }

def host = props.getProperty('host', 'localhost') + ':' + props.getProperty('port', '18080')
def client = HttpClient.newHttpClient()
def open = { String hdr, String c, BlockingQueue q -&gt;
  client.newWebSocketBuilder().header(hdr, c).buildAsync(URI.create('ws://' + host + '/ws'), new WebSocket.Listener() {
    StringBuilder sb = new StringBuilder()
    void onOpen(WebSocket ws) { ws.request(1) }
    CompletionStage onText(WebSocket ws, CharSequence d, boolean last) { sb.append(d); if (last) { q.add(sb.toString()); sb.setLength(0) }; ws.request(1); return null }
    void onError(WebSocket ws, Throwable t) { q.add('ERROR ' + t) }
    CompletionStage onClose(WebSocket ws, int s, String r) { q.add('CLOSE ' + s); return null }
  }).get(5, TimeUnit.SECONDS)
}
def cq = new LinkedBlockingQueue(), mq = new LinkedBlockingQueue()
def cust = open('user-context', ctx('user', vars.get('userId')), cq)
def mech = open('mechanic-context', ctx('mechanic', vars.get('mechanicId')), mq)
vars.putObject('cust', cust); vars.putObject('mech', mech); vars.putObject('cq', cq); vars.putObject('mq', mq)
cust.sendText('CONNECT\naccept-version:1.2\nheart-beat:0,0\n\n' + nul, true)
mech.sendText('CONNECT\naccept-version:1.2\nheart-beat:0,0\n\n' + nul, true)
def a = cq.poll(5, TimeUnit.SECONDS), b = mq.poll(5, TimeUnit.SECONDS)
if (!a?.startsWith('CONNECTED') || !b?.startsWith('CONNECTED')) throw new Exception('no CONNECTED: ' + a + ' / ' + b)
cust.sendText('SUBSCRIBE\nid:s1\nreceipt:r1\ndestination:/topic/sos/' + vars.get('sosId') + '/location\n\n' + nul, true)
// Spring's simple broker does not answer a receipt header, so wait a beat for the subscription to register.
Thread.sleep(200)
</stringProp></JSR223Sampler><hashTree/><LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="until duration" enabled="true"><stringProp name="LoopController.loops">-1</stringProp></LoopController><hashTree><JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="STOMP ping -> broadcast" enabled="true"><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="parameters"></stringProp><stringProp name="filename"></stringProp><stringProp name="cacheKey">true</stringProp><stringProp name="script">
import java.net.URI
import java.net.http.*
import java.util.concurrent.*
def nul = "" + (char) 0
def ctx = { String key, String id -&gt; '{"' + key + '":{"uuid":"' + id + '",' + (key == 'user' ? '"role":"USER",' : '') + '"otpVerify":true,"profileVerify":true,"tokenStatus":"active","isLogout":false}}' }

def cq = vars.getObject('cq'), mech = vars.getObject('mech')
mech.sendText('SEND\ndestination:/app/mechanic/location\ncontent-type:application/json\n\n{"latitude":' + vars.get('mlat') + ',"longitude":' + vars.get('mlng') + ',"sosId":"' + vars.get('sosId') + '"}' + nul, true)
def m = cq.poll(5, TimeUnit.SECONDS)
if (m == null || !m.startsWith('MESSAGE')) throw new Exception('no broadcast: ' + m)
</stringProp></JSR223Sampler><hashTree/><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/v1/sos/{id}" enabled="true"><stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,18080)}</stringProp><stringProp name="HTTPSampler.path">/api/v1/sos/${sosId}</stringProp><stringProp name="HTTPSampler.method">GET</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="hdr" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">user-context</stringProp><stringProp name="Header.value">{&quot;user&quot;:{&quot;uuid&quot;:&quot;${userId}&quot;,&quot;role&quot;:&quot;USER&quot;,&quot;otpVerify&quot;:true,&quot;profileVerify&quot;:true,&quot;tokenStatus&quot;:&quot;active&quot;,&quot;isLogout&quot;:false}}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="status 200" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">200</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree><HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="PATCH /api/v1/mechanics/{id}/location" enabled="true"><stringProp name="HTTPSampler.domain">${__P(host,localhost)}</stringProp><stringProp name="HTTPSampler.port">${__P(port,18080)}</stringProp><stringProp name="HTTPSampler.path">/api/v1/mechanics/${mechanicId}/location?lat=${mlat}&amp;lng=${mlng}</stringProp><stringProp name="HTTPSampler.method">PATCH</stringProp></HTTPSamplerProxy><hashTree><HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="hdr" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">mechanic-context</stringProp><stringProp name="Header.value">{&quot;mechanic&quot;:{&quot;uuid&quot;:&quot;${mechanicId}&quot;,&quot;otpVerify&quot;:true,&quot;profileVerify&quot;:true,&quot;tokenStatus&quot;:&quot;active&quot;,&quot;isLogout&quot;:false}}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/><ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="status 204" enabled="true"><collectionProp name="Asserion.test_strings"><stringProp name="1">204</stringProp></collectionProp><stringProp name="Assertion.test_field">Assertion.response_code</stringProp><intProp name="Assertion.test_type">8</intProp></ResponseAssertion><hashTree/></hashTree><UniformRandomTimer guiclass="UniformRandomTimerGui" testclass="UniformRandomTimer" testname="think" enabled="true"><stringProp name="ConstantTimer.delay">500</stringProp><stringProp name="RandomTimer.range">1500</stringProp></UniformRandomTimer><hashTree/></hashTree></hashTree></hashTree></hashTree></jmeterTestPlan>