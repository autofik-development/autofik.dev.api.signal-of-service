SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres
DB_PASSWORD=root1234
DB_POOL_MAX=20
# Keep equal to DB_POOL_MAX (a fixed-size pool, HikariCP's recommendation). A lower value lets idle
# connections close; the next burst then waits for new ones, which took up to 2 s in the 2 h soak.
DB_POOL_MIN_IDLE=20

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Kafka login. PLAINTEXT (the default) needs nothing else. For a cluster with SCRAM users set
# SASL_PLAINTEXT and the JAAS line from the app's KafkaUser Secret, e.g.
# KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="signal-of-service" password="...";
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_JAAS_CONFIG=

REDIS_HOST=localhost
REDIS_PORT=6379
# Blank for a local Redis without AUTH; the cluster's Redis (secrets/platform/redis_password) needs it.
REDIS_PASSWORD=
WEBSOCKET_ALLOWED_ORIGINS=*

GOOGLE_MAPS_API_KEY=your_api_key_here

ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_API_KEY=your_onesignal_rest_api_key_here

MEDUSA_BASE_URL=http://localhost:9000
MEDUSA_PUBLIC_KEY=pk_your_publishable_key_here

# Kafka replication factor for app-managed topics. 1 is correct for this repo's single-broker
# dev Kafka — raise to 3 for a multi-broker SIT/prod cluster, or topic creation under-replicates.
KAFKA_TOPIC_REPLICATION_FACTOR=1

# How often a mechanic's location ping may trigger a real Google Distance Matrix call (seconds).
# Directly drives Maps API spend — this refresh loop is ~86% of it. Raise to cut cost.
SOS_ETA_REFRESH_INTERVAL_SECONDS=30

# A mechanic may only mark ARRIVED when their last known position is within this many metres
# (road distance) of the SOS. Raise if legitimate arrivals are being rejected.
SOS_ARRIVAL_MAX_DISTANCE_M=50

# Step size and ceiling (km) for auto-widening the broadcast radius on a zero-bid retry. Separate
# from the customer's own broadcastRadiusKm cap — this is the system's last-resort fallback.
SOS_AUTO_EXPAND_STEP_KM=5
SOS_AUTO_EXPAND_MAX_KM=35

# Max photos (presigned S3 URLs) attached to each SOS broadcast sent to nearby mechanics.
SOS_BROADCAST_MAX_PHOTOS=3

# S3-compatible storage for SOS photos. Endpoint, region and bucket default in application.yaml;
# override with S3_ENDPOINT / S3_REGION / S3_BUCKET_NAME only if pointing somewhere else.
S3_ACCESS_KEY=your_s3_access_key_here
S3_SECRET_KEY=your_s3_secret_key_here

# How long presigned S3 photo URLs stay valid (minutes).
S3_PRESIGN_TTL_MINUTES=15
# Lifetime of the cached ETA snapshot (minutes). Keep well above SOS_ETA_REFRESH_INTERVAL_SECONDS.
SOS_ETA_CACHE_TTL_MINUTES=15
# Mechanic GPS written to Postgres at most once per this many seconds.
MECHANIC_LOCATION_PG_SYNC_SECONDS=10

# H3 grid resolution for mechanic lookup. Do not change without recomputing every stored
# current_h3_index. SOS_H3_CENTER_TO_CENTER_KM must match it (2.114 is for resolution 7 only).
SOS_H3_RESOLUTION=7
SOS_H3_CENTER_TO_CENTER_KM=2.114
# Mean Earth radius (metres) for straight-line distance fallbacks.
SOS_EARTH_RADIUS_M=6371000
# Max source image width/height (pixels) accepted for SOS photos. Guard against decompression bombs.
SOS_MEDIA_MAX_SOURCE_DIMENSION=8000

# Bidding: seconds per broadcast attempt, max rebroadcasts, default radius (km) when the customer
# sets none, and minimum gap (seconds) between two SOS creations by the same user.
SOS_BIDDING_WINDOW_SECONDS=60
SOS_MAX_REBROADCAST=3
SOS_DEFAULT_BROADCAST_KM=15
SOS_CREATE_COOLDOWN_SECONDS=60
# SOS photo handling: max upload size (MB, also drives the multipart limit), resize box (px),
# JPEG re-encode quality (0.0-1.0).
SOS_MEDIA_MAX_UPLOAD_MB=10
SOS_MEDIA_MAX_IMAGE_DIMENSION=1280
SOS_MEDIA_JPEG_QUALITY=0.80
# Kafka: partitions per app-managed topic (can only be increased on existing topics), consumer group.
KAFKA_TOPIC_PARTITIONS=3
KAFKA_CONSUMER_GROUP_ID=sos-location-group
# Fail-fast timeouts (ms) for the DB connection pool and Redis commands.
DB_CONNECTION_TIMEOUT_MS=5000
REDIS_TIMEOUT_MS=1000

# Dispatch: a mechanic whose last location ping is older than this (minutes) gets no offers and
# cannot bid. A mechanic with no recorded ping yet is treated as fresh.
SOS_DISPATCH_LOCATION_MAX_AGE_MINUTES=5
# Dispatch: longest road ETA (minutes) for an offer or a bid; 0 disables. Needs a Google estimate.
SOS_DISPATCH_MAX_ROAD_ETA_MINUTES=30

# No-show: minutes an assigned mechanic may stand still before being asked "are you still coming?"
# (0 turns it off), and seconds they have to answer before the job is released.
SOS_NO_SHOW_STALLED_MINUTES=5
SOS_NO_SHOW_PROMPT_RESPONSE_SECONDS=60
# Metres a location ping must differ from the previous one to count as the mechanic having moved.
SOS_LOCATION_MOVED_THRESHOLD_M=20
# Shared secret the internal gateway sends in the X-Edge-Auth header on every request (health checks
# excepted). Blank turns the check off; set it in every deployed environment. Use a long random value
# and the same one on the gateway.
SOS_GATEWAY_SECRET=

# Jaeger / OpenTelemetry distributed tracing. The same four variables, with the same meanings, drive
# the internal gateway and SSO, so a request through the gateway is one trace across all three.
# Local Jaeger: docker run -d --name jaeger -p 16686:16686 -p 4317:4317 -p 4318:4318 jaegertracing/jaeger:2.21.0
# then browse http://localhost:16686.
# Only the exact string "false" turns span export off (the gateway's traceparent is still passed on).
JAEGER_ENABLED=true
JAEGER_SERVICE_NAME=autofik-sos-service
# Jaeger's OTLP/HTTP receiver, full URL including /v1/traces.
JAEGER_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Fraction of the traces started here that are kept, 0 to 1 (clamped). Requests from the gateway
# follow the gateway's decision.
JAEGER_SAMPLE_RATIO=1

# Read by application.yaml; value shown is its default.
GOOGLE_MAPS_BASE_URL=
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=10000
KAFKA_PRODUCER_MAX_BLOCK_MS=2000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=5000
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
S3_BUCKET_NAME=autofik-sos-api
S3_ENDPOINT=https://fsgw.evauto24.com/
S3_REGION=us-east-1
SOS_COMPLETION_APPROVAL_WINDOW_SECONDS=120
SOS_COMPLETION_SWEEP_INTERVAL_MS=15000
SOS_ETA_OFFER_ESTIMATE_MAX_AGE_SECONDS=300
SOS_ETA_OFFER_MAX_MECHANICS=25
SOS_GATEWAY_HEADER=X-Edge-Auth
SOS_NO_SHOW_SWEEP_INTERVAL_MS=30000
